# ==============================================================================
# RAMU ROASTERY — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Salin file ini menjadi .env di server produksi (Vercel / VPS / Railway).
# PENTING: JANGAN PERNAH COMMIT FILE .env YANG BERISI KUNCI ASLI KE GIT!
# ==============================================================================

# 1. DATABASE CONFIGURATION (PostgreSQL)
# Gunakan connection string dengan sslmode=require di lingkungan produksi
DATABASE_URL="postgresql://user:securepassword@your-db-host:5432/ramuroastery?schema=public&sslmode=require"

# 2. PAYMENT GATEWAY (iPay88 Production / Sandbox)
# Dapatkan dari dashboard resmi iPay88: https://www.ipay88.co.id/
IPAY88_MERCHANT_CODE="ID00000"
IPAY88_MERCHANT_KEY="YourSecureIpay88MerchantKey"

# 3. ADMINISTRATOR SECURITY (HMAC-SHA256 Token Signing)
# Gunakan string acak panjang (minimal 32 karakter) untuk keamanan produksi
ADMIN_JWT_SECRET="generate_random_32_characters_secret_string_here_2026!"
ADMIN_USERNAME="admin_ramu"
ADMIN_PASSWORD="StrongProductionAdminPassword2026!"

# 4. OPTIONAL WEBHOOK TEST SECRET (Untuk simulasi pengujian aman tanpa gateway)
WEBHOOK_SECRET_TOKEN="your_custom_webhook_secret_token_here"

# 5. EXPEDITION / SHIPPING API (RajaOngkir)
# https://rajaongkir.com/
RAJAONGKIR_API_KEY="your_rajaongkir_api_key_here"

